<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificate authorities that ship with Android: a certificate the user
     (or a network admin) installed on the phone is not trusted, so traffic cannot be read that way. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
